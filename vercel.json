{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "regions": ["gru1"],
  "functions": {
    "api/postal.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/client-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sql-wasm.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
